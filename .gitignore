target/

# Ignore all compiled Java class files
*.class

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Ignore IntelliJ and Eclipse project files
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Ignore VS Code settings
.vscode/

